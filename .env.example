# ==============================================================================
# CREATOR-BRAND PLATFORM ENVIRONMENT CONFIGURATION
# All services use $0 Free Tiers or Quotas for the Hackathon
# ==============================================================================

# Google Gemini API (Free tier from Google AI Studio)
# https://aistudio.google.com/
GEMINI_API_KEY=""

# YouTube Data API v3 (Free 10,000 units/day from Google Cloud Console)
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=""

# Twitch Helix API (Free application registration from Twitch Dev Console)
# https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

# Supabase Free Tier (Optional for local mode, required for remote Postgres)
# https://supabase.com/
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Optional Mock Mode (Set to "true" to force local seed fallbacks even without API keys)
NEXT_PUBLIC_USE_MOCK_FALLBACK="true"
